# Copy these values into the .env used by the official OpenClaw Compose stack.
# Do not commit the real .env: it also contains the Gateway token and provider
# credentials.

# Absolute host path to ONE AILearningOS user's vault. The server writes notes
# under server/data/obsidian-vault/{userId}; set the matching userId here.
AI_STUDY_OBSIDIAN_VAULT_HOST_PATH=/opt/ai-study-os/server/data/obsidian-vault/1

# Optional, but recommended for the China timezone used by this product.
OPENCLAW_TZ=Asia/Shanghai
